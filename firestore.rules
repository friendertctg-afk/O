rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all paths unless explicitly matched
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.displayName is string &&
             data.displayName.size() >= 1 &&
             data.displayName.size() <= 80 &&
             data.lastSurah is int &&
             data.lastSurah >= 1 &&
             data.lastSurah <= 114 &&
             data.lastAyah is int &&
             data.lastAyah >= 1 &&
             data.lastAyah <= 286 &&
             data.totalTasbihCount is int &&
             data.totalTasbihCount >= 0 &&
             data.hifzAyahsCount is int &&
             data.hifzAyahsCount >= 0 &&
             data.hifzAyahsCount <= 6236 &&
             data.preferredTheme is string &&
             data.preferredTheme.size() >= 1 &&
             data.preferredTheme.size() <= 40 &&
             data.preferredLanguage is string &&
             data.preferredLanguage.size() >= 2 &&
             data.preferredLanguage.size() <= 10 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidBookmark(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.surahNumber is int &&
             data.surahNumber >= 1 &&
             data.surahNumber <= 114 &&
             data.ayahNumber is int &&
             data.ayahNumber >= 1 &&
             data.ayahNumber <= 286 &&
             data.surahName is string &&
             data.surahName.size() >= 1 &&
             data.surahName.size() <= 80 &&
             (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 500)) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidHifzProgress(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.surahNumber is int &&
             data.surahNumber >= 1 &&
             data.surahNumber <= 114 &&
             data.memorizedAyahs is int &&
             data.memorizedAyahs >= 0 &&
             data.memorizedAyahs <= 286 &&
             data.targetAyahs is int &&
             data.targetAyahs >= 1 &&
             data.targetAyahs <= 286 &&
             data.memorizedAyahs <= data.targetAyahs &&
             data.status is string &&
             data.status in ['in_progress', 'memorized', 'revision'] &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidLearningProgress(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.moduleType is string &&
             data.moduleType in ['arabic', 'tajweed'] &&
             data.lessonKey is string &&
             data.lessonKey.size() >= 1 &&
             data.lessonKey.size() <= 80 &&
             data.completed is bool &&
             data.quizScore is int &&
             data.quizScore >= 0 &&
             data.quizScore <= 100 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll([
                         'userId', 'displayName', 'lastSurah', 'lastAyah',
                         'totalTasbihCount', 'hifzAyahsCount',
                         'preferredTheme', 'preferredLanguage',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'displayName', 'lastSurah', 'lastAyah',
                         'totalTasbihCount', 'hifzAyahsCount',
                         'preferredTheme', 'preferredLanguage',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'lastSurah', 'lastAyah',
                         'totalTasbihCount', 'hifzAyahsCount',
                         'preferredTheme', 'preferredLanguage', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /bookmarks/{bookmarkId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(bookmarkId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(bookmarkId) &&
                         incoming().keys().hasAll([
                           'userId', 'surahNumber', 'ayahNumber', 'surahName',
                           'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'surahNumber', 'ayahNumber', 'surahName',
                           'note', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidBookmark(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(bookmarkId) &&
                         isValidBookmark(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'surahNumber', 'ayahNumber', 'surahName', 'note', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(bookmarkId);
      }

      match /hifz_progress/{progressId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(progressId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(progressId) &&
                         incoming().keys().hasAll([
                           'userId', 'surahNumber', 'memorizedAyahs', 'targetAyahs',
                           'status', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'surahNumber', 'memorizedAyahs', 'targetAyahs',
                           'status', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidHifzProgress(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(progressId) &&
                         isValidHifzProgress(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'memorizedAyahs', 'targetAyahs', 'status', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(progressId);
      }

      match /learning_progress/{lessonId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(lessonId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(lessonId) &&
                         incoming().keys().hasAll([
                           'userId', 'moduleType', 'lessonKey', 'completed',
                           'quizScore', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'moduleType', 'lessonKey', 'completed',
                           'quizScore', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidLearningProgress(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(userId) &&
                         isValidId(lessonId) &&
                         isValidLearningProgress(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'completed', 'quizScore', 'updatedAt'
                         ]);

        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(lessonId);
      }
    }
  }
}
